      "name": "Customer",
      "item": [
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "customers"
              ],
              "variable": []
            },
            "description": "Create a new individual customer profile with identification details, address information, and KYC compliance data.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"johndoe06@email.com\",\n  \"phone\": \"+23490123456789\",\n  \"country_code\": \"NG\",\n  \"date_of_birth\": \"1970-12-28\",\n  \"gender\": \"male\",\n  \"documents\": [\n    {\n      \"id_type\": \"national_id\",\n      \"id_number\": \"1096277890\",\n      \"front_doc\": \"<base64-encoded image>\"\n    }\n  ],\n  \"address\": {\n    \"street\": \"12 Lekki Lane\",\n    \"city\": \"Lekki\",\n    \"state\": \"Lagos\",\n    \"postal_code\": \"200123\",\n    \"country\": \"Nigeria\",\n    \"document\": \"<base64-encoded proof of address>\"\n  },\n  \"proof_of_funds\": {\n    \"employment_status\": \"employed\",\n    \"occupation\": \"151252\",\n    \"primary_purpose\": \"payments_to_friends_or_family_abroad\",\n    \"source_of_funds\": \"salary\",\n    \"expected_monthly_pay\": \"0_4999\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "customers"
              ],
              "variable": []
            },
            "description": "Retrieve a paginated list of customers."
          }
        },
        {
          "name": "Get customer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/customers/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "customers",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "description": "Retrieve a specific customer by ID."
          }
        },
        {
          "name": "Update customer",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/customers/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "customers",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "description": "Partially update a customer. All body fields are optional; include only fields you want to change. Use documents and proof_of_funds for KYC updates.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Jane\",\n  \"phone\": \"+2348012345678\",\n  \"documents\": [\n    {\n      \"id_type\": \"passport\",\n      \"id_number\": \"A12345678\",\n      \"front_doc\": \"<base64-encoded image>\"\n    }\n  ],\n  \"proof_of_funds\": {\n    \"employment_status\": \"employed\",\n    \"occupation\": \"151252\",\n    \"primary_purpose\": \"payments_to_friends_or_family_abroad\",\n    \"source_of_funds\": \"salary\",\n    \"expected_monthly_pay\": \"0_4999\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
