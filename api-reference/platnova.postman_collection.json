              "variable": [
                {
                  "key": "checkout_id",
                  "value": ""
                }
              ]
            },
            "description": "Needs no authentication. Returns 404 once the checkout is more than 7 days old, paid or not; confirm payments with POST /v1/payments/verify."
          }
