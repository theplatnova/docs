            "body": {
              "mode": "raw",
              "raw": "{\n  \"wallet_id\": \"43a2b75e-5c59-429e-872a-2a54c7b17e37\",\n  \"codes\": [\n    \"CHASUS33\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
