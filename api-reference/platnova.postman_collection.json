                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "virtual-accounts",
                "create"
              ],
              "variable": []
            },
            "description": "Create a virtual bank account for a customer in the specified currency. Requires customer_id and currency. For NGN, id_number (BVN) may be required.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"NGN\",\n  \"customer_id\": \"43a2b75e-5c59-429e-872a-2a54c7b17e34\",\n  \"id_number\": \"22123456789\",\n  \"codes\": [\n    \"058\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Generate single-use virtual account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/virtual-accounts/dynamic",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "virtual-accounts",
                "dynamic"
              ],
              "variable": []
            },
            "description": "Generate a dynamic, single-use virtual account for a customer with a fixed amount and configurable expiry. The account automatically expires after the specified lifespan and can only receive a payment matching the exact amount.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"aad8aff0-00db-48b0-9bb0-9b399c313438\",\n  \"amount\": 200,\n  \"lifespan_minutes\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
