                "v1",
                "checkout"
              ],
              "variable": []
            },
            "description": "Create a hosted checkout for a sale. Authenticate with X-API-Key only: a dashboard session makes a self top-up instead.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\",\n  \"amount\": 25000,\n  \"currency\": \"ngn\",\n  \"partner_reference\": \"order-1042\",\n  \"success_url\": \"https://shop.example.com/orders/1042/paid\",\n  \"cancel_url\": \"https://shop.example.com/orders/1042\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
