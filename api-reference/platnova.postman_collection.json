        {
          "name": "Reveal card details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/cards/:card_id/reveal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "cards",
                ":card_id",
                "reveal"
              ],
              "variable": [
                {
                  "key": "card_id",
                  "value": ""
                }
              ]
            },
            "description": "Retrieve full card number and CVV. Rate-limited for security."
          }
        },
        {
          "name": "Terminate card",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/cards/:card_id/terminate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "cards",
                ":card_id",
                "terminate"
              ],
              "variable": [
                {
                  "key": "card_id",
                  "value": ""
                }
              ]
            },
            "description": "Close a card permanently. The card stops working at once and cannot be reactivated. Any balance on it is returned by the card issuer and credited back automatically, usually within a minute; `balance_refund` in the response says whether that is still to come. Terminating a card that is already terminated returns 200 with `already_terminated: true`, so the call is safe to retry."
          }
